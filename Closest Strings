import java.util.*;
class Solution {
    public static int shortestDistance(ArrayList<String> s, String word1, String word2) {
        int x=-1;
        int y=-1;
        int ans=Integer.MAX_VALUE;
        for(int i=0;i<s.size();i++){
            if(s.get(i).equals(word1)){
                x=i;
            }
            if(s.get(i).equals(word2)){
                y=i;
            }
            
            if(x!=-1 && y!=-1){
                ans=Math.min(ans,Math.abs(y-x));
            }
        }
        return ans;
        
    }
    public static void main(String args[]){
        Scanner s=new Scanner(System.in);
        String str=s.nextLine();
        String word1=s.nextLine().trim();
        String word2=s.nextLine().trim();
        str=str.substring(1,str.length()-1);
        String v[]=str.split(",");
        int n=v.length;
        ArrayList<String> list=new ArrayList<>();
        for(int i=0;i<n;i++){
             v[i]=v[i].trim();
             list.add(v[i]);
        }
        System.out.println(shortestDistance(list,word1,word2));
    }
};
